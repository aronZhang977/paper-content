<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="alexnet_mindmap" name="AlexNet精读思维导图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="3398" background="#FFFFFF" math="0" shadow="0">
      <root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="root" value="AlexNet&lt;br&gt;ImageNet Classification with&lt;br&gt;Deep Convolutional Neural Networks&lt;br&gt;(Krizhevsky, Sutskever, Hinton&lt;br&gt;Toronto, NIPS 2012)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#1565C0;fontColor=#FFFFFF;fontSize=14;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="40" y="1624" width="260" height="110" as="geometry" /></mxCell>
<mxCell id="e_r_b0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1976D2;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="root" target="b0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_r_b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1976D2;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="root" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_r_b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1976D2;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="root" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_r_b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1976D2;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="root" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_r_b4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1976D2;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="root" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_r_b5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1976D2;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="root" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b0" value="① 问题与时代条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1976D2;fontColor=#000000;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="285" width="200" height="50" as="geometry" /></mxCell>
<mxCell id="l0_0" value="数据规模跃迁：数万张 → ImageNet 1500万张/22000类；ILSVRC子集120万训练、5万验证、15万测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="20" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b0_l0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b0" target="l0_0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l0_1" value="为什么选 CNN：统计平稳性（滤波器复用）+ 像素依赖局部性；容量由深度宽度控制，参数少易训练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="98" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b0_l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b0" target="l0_1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l0_2" value="核心瓶颈：大规模高分辨率 CNN 训练昂贵得令人却步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="176" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b0_l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b0" target="l0_2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l0_3" value="三条件首次汇合：CNN 模型 + ImageNet 数据 + GPU 算力；接上后暴露两件事：训练慢、过拟合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="254" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b0_l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b0" target="l0_3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l0_4" value="硬件：GTX 580 3GB×2，训练 5-6 天；作者手写 CUDA 卷积并开源（cuda-convnet）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="332" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b0_l4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b0" target="l0_4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l0_5" value="作者：Krizhevsky / Sutskever / Hinton（多伦多大学），NIPS 2012" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="410" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b0_l5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b0" target="l0_5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b1" value="② 网络结构：8 个可学习层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1976D2;fontColor=#000000;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="865" width="200" height="50" as="geometry" /></mxCell>
<mxCell id="l1_0" value="总览：5 conv + 3 FC + 1000 路 softmax；6000 万参数、65 万神经元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="600" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b1_l0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b1" target="l1_0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l1_1" value="ReLU：f(x)=max(0,x) 非饱和，比 tanh 快 6 倍达 25% 误差（图1）——让大模型实验成为可能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="678" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b1_l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b1" target="l1_1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l1_2" value="多 GPU：按卷积核切分（模型并行），仅特定层通信；top-1/top-5 降 1.7%/1.2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="756" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b1_l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b1" target="l1_2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l1_3" value="LRN 局部响应归一化：跨相邻特征图的侧抑制（亮度归一化）；k=2,n=5,α=1e-4,β=0.75；降 1.4%/1.2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="834" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b1_l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b1" target="l1_3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l1_4" value="重叠池化：步长 s=2、窗口 z=3（s&lt;z）；降 0.4%/0.3%，且更难过拟合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="912" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b1_l4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b1" target="l1_4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l1_5" value="各层配置：conv1 96个11×11×3/步长4 → conv2 256个5×5×48 → conv3 384个3×3×256 → conv4 384个3×3×192 → conv5 256个3×3×192；FC 各 4096" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="990" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b1_l5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b1" target="l1_5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b2" value="③ 减轻过拟合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1976D2;fontColor=#000000;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="1445" width="200" height="50" as="geometry" /></mxCell>
<mxCell id="l2_0" value="问题量级：6000万参数，每样本仅约10比特约束（log₂1000），数据不够" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1180" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b2_l0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b2" target="l2_0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2_1" value="数据增强①：256图随机裁224块+水平翻转，训练集扩 2048 倍（32×32×2），CPU现算不占GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1258" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b2_l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b2" target="l2_1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2_2" value="测试时 10-crop：四角+中心共5块及其翻转，softmax 输出平均（额外降 1.5/1.3 个点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1336" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b2_l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b2" target="l2_2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2_3" value="数据增强②：对RGB像素做PCA，按特征值加高斯扰动，模拟光照强度/颜色不变性，top-1 降 &gt;1%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1414" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b2_l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b2" target="l2_3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2_4" value="Dropout：p=0.5 随机置零隐藏神经元，每次采样不同结构但共享权重=廉价的指数级模型集成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1492" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b2_l4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b2" target="l2_4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2_5" value="测试时全部神经元输出×0.5（几何平均近似）；仅用于 fc6/fc7，收敛迭代约翻倍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1570" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b2_l5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b2" target="l2_5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b3" value="④ 学习细节（训练配方）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1976D2;fontColor=#000000;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="1986" width="200" height="50" as="geometry" /></mxCell>
<mxCell id="l3_0" value="SGD：batch size 128，momentum 0.9，weight decay 0.0005" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1760" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b3_l0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b3" target="l3_0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l3_1" value="权重衰减不仅是正则项，还降低模型的训练误差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1838" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b3_l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b3" target="l3_1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l3_2" value="初始化：权重零均值高斯 std=0.01；conv2/4/5及FC隐层 bias=1（早期给ReLU正输入），其余为0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1916" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b3_l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b3" target="l3_2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l3_3" value="学习率：全层相同，初始0.01；验证误差停滞时÷10，共手动降3次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="1994" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b3_l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b3" target="l3_3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l3_4" value="训练量：约 90 个 epoch，两块 GTX 580，5-6 天" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2072" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b3_l4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b3" target="l3_4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b4" value="⑤ 实验证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1976D2;fontColor=#000000;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="2527" width="200" height="50" as="geometry" /></mxCell>
<mxCell id="l4_0" value="ILSVRC-2010：37.5%/17.0%（top-1/top-5），对手 SIFT+FV 45.7%/25.7%、稀疏编码 47.1%/28.2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2262" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b4_l0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b4" target="l4_0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l4_1" value="ILSVRC-2012：单CNN 18.2% → 5CNN集成16.4% → 7CNN（含预训练）15.3%；第二名仅26.2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2340" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b4_l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b4" target="l4_1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l4_2" value="Fall 2009 版（10184类/890万图）：67.4%/40.9%，此前最好 78.1%/60.9%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2418" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b4_l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b4" target="l4_2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l4_3" value="预训练+微调：在1500万图全集预训练再微调，单模型 18.2%→16.6%（预训练范式早期样本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2496" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b4_l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b4" target="l4_3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l4_4" value="定性·图3：第一层核呈频率/方向选择性；GPU1偏灰度边缘、GPU2偏彩色斑块，自发分工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2574" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b4_l4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b4" target="l4_4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l4_5" value="定性·图4：fc7特征空间近邻像素并不相似（狗/大象姿态各异）→ 高层编码语义而非外观" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2652" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b4_l5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b4" target="l4_5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b5" value="⑥ 结论与历史影响" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1976D2;fontColor=#000000;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="3107" width="200" height="50" as="geometry" /></mxCell>
<mxCell id="l5_0" value="仅凭纯监督学习即破纪录；去掉任一中间卷积层 top-1 掉约2%（卷积层参数&lt;1%）→ 深度重要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2842" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b5_l0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="l5_0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l5_1" value="但只证明了“去掉变差”，没有证明“加深更好”——后者留给 VGG / ResNet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2920" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b5_l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="l5_1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l5_2" value="留下来的默认配置：ReLU 成默认激活、dropout 成FC标准正则、裁剪+翻转+颜色扰动成固定配方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="2998" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b5_l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="l5_2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l5_3" value="LRN 是唯一未留存的零件（VGG称无效，后被批归一化BN取代）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="3076" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b5_l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="l5_3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l5_4" value="引爆深度学习：LeCun 称其为CV史明确转折点；后续冠军 ZFNet→VGG/GoogLeNet→ResNet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="3154" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b5_l4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="l5_4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l5_5" value="作者承认未做：无监督预训练（预期有帮助）、扩展到视频序列（时间结构）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#42A5F5;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" parent="1" vertex="1"><mxGeometry x="660" y="3232" width="480" height="52" as="geometry" /></mxCell>
<mxCell id="e_b5_l5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#42A5F5;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="l5_5"><mxGeometry relative="1" as="geometry" /></mxCell>
